{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@models/*": ["server/src/models/*"],
            "@middleware/*": ["server/src/middleware/*"],
            "@services/*": ["server/src/services/*"],
            "@routes/*": ["server/src/routes/*"]
        }
    }
}
