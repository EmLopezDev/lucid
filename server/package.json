{
    "name": "server",
    "version": "1.0.0",
    "description": "",
    "type": "commonjs",
    "scripts": {
        "start": "node dist/server/src/server.js",
        "build": "tsc && tsc-alias",
        "dev": "nodemon --exec tsx src/server.ts",
        "seed": "node --env-file=.env --import tsx scripts/seed.ts",
        "seed:demo": "node --env-file=.env --import tsx scripts/seed-demo.ts",
        "migrate:email-verified": "node --env-file=.env --import tsx scripts/migrations/migrate-email-verified.ts",
        "migrate:genres": "node --env-file=.env --import tsx scripts/migrations/migrate-genres.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@sentry/node": "^10.52.0",
        "bcryptjs": "^3.0.3",
        "connect-mongo": "^6.0.0",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^8.5.1",
        "express-session": "^1.19.0",
        "helmet": "^8.1.0",
        "mongoose": "^9.4.1",
        "nodemailer": "^8.0.7",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "zod": "^4.3.6",
        "dotenv": "^17.4.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.19.0",
        "@types/nodemailer": "^8.0.0",
        "@types/supertest": "^7.2.0",
        "@types/node": "^25.6.0",
        "typescript": "^6.0.2",
        "eslint": "^10.3.0",
        "mongodb-memory-server": "^11.1.0",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "supertest": "^7.2.2",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.21.0",
        "typescript-eslint": "^8.59.2",
        "vitest": "^4.1.5"
    }
}
